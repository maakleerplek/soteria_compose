# =============================================================================
# soteria-compose secrets — copy to .env and fill in values
# NEVER commit .env to Git — store in Bitwarden + back up to TrueNAS
# =============================================================================

# --- sot-prod-auth-authentik -------------------------------------------------
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=
AUTHENTIK_SECRET_KEY=                   # generate: openssl rand -base64 60
AUTHENTIK_EMAIL_HOST=
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USE_TLS=true
AUTHENTIK_EMAIL_FROM=

# --- sot-prod-wiki-wikijs -----------------------------------------------------
WIKI_POSTGRES_DB=wiki
WIKI_POSTGRES_USER=wikijs
WIKI_POSTGRES_PASSWORD=
